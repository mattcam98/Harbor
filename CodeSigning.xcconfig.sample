// Copied to CodeSigning.xcconfig (not committed) by scripts/generate-project.sh.
// Edit your copy; never commit it.

// Your Apple developer team identifier, from Xcode's Signing & Capabilities
// tab. Leave empty for simulator builds and for unsigned IPAs.
DEVELOPMENT_TEAM =

// Harbor's bundle identifier. Harbor Setup adds your team identifier to it
// when it installs Harbor, so the default works for everyone there. When
// you build and run from Xcode instead, use one of your own, such as
// com.yourname.harbor: Xcode registers it exactly as written.
HARBOR_BUNDLE_ID = com.example.harbor
